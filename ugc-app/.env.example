# ─────────────────────────────────────────────────────────────
# Nexeire — environment template
# Copy to .env.local and fill in the REQUIRED values to run the MVP.
# Everything below "OPTIONAL" already has sane defaults in code.
# ─────────────────────────────────────────────────────────────

# ===== REQUIRED: Supabase (Postgres + Auth + Storage) =====
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used by server actions and provider webhooks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ===== REQUIRED: Admin access =====
# Comma-separated list of emails allowed into the admin/fulfilment views.
ADMIN_EMAILS=you@example.com

# ===== REQUIRED: Script generation (OpenAI) =====
# Set SCRIPT_GENERATION_PROVIDER=fixture to click through the app without an OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SCRIPT_GENERATION_PROVIDER=openai

# ===== REQUIRED: Voiceover (ElevenLabs) =====
# Set RENDER_PROVIDER=test (below) to render without hitting real providers.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== REQUIRED: Internal route secrets =====
# Random strings you generate (e.g. `openssl rand -hex 32`). Guard the cron/worker API routes.
REMOTION_PROGRESS_SECRET=
VIDEO_WORKER_SECRET=
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — defaults below match the code; change only if needed.
# ─────────────────────────────────────────────────────────────

# Rendering provider: "remotion" (real) or "test" (skips real render, for local/dev).
RENDER_PROVIDER=remotion

# ElevenLabs voice tuning + cost estimate
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.3
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.65
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_ESTIMATED_CENTS_PER_1K_CHARS=30

# Remotion render sizing + cost estimate
REMOTION_ESTIMATED_CENTS_PER_VIDEO=80
REMOTION_SANDBOX_VCPUS=4
REMOTION_SANDBOX_TIMEOUT_MS=600000
REMOTION_RENDER_TIMEOUT_MS=600000
# Optional: set to enable detached rendering via Vercel Blob storage.
BLOB_READ_WRITE_TOKEN=

# Base URL used to build provider webhook callback URLs.
APP_BASE_URL=http://127.0.0.1:3000

# Agentation visual-feedback toolbar (local dev only).
NEXT_PUBLIC_ENABLE_AGENTATION=false
NEXT_PUBLIC_AGENTATION_ENDPOINT=
